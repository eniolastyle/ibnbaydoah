# ==============================================================================
# Ibn Baydoah Platform — Environment Variables Template
# Copy to .env for local development or configure in Coolify Environment tab.
# NEVER commit real passwords or API keys to Git.
# ==============================================================================

# Server Port (defaults to 3000)
PORT="3000"

# APP_URL: The public URL where this platform is hosted
APP_URL="https://ibnbaydoh.com.ng"

# ------------------------------------------------------------------------------
# PostgreSQL Metadata Database (Coolify / Production)
# When omitted in local preview, the server automatically uses server/data/db.json
# ------------------------------------------------------------------------------
POSTGRES_USER="ibn_baydoah"
POSTGRES_PASSWORD="YOUR_STRONG_POSTGRES_PASSWORD"
POSTGRES_DB="ibn_baydoah"
DATABASE_URL="postgres://ibn_baydoah:YOUR_STRONG_POSTGRES_PASSWORD@postgres:5432/ibn_baydoah"
# Set to "true" ONLY on a brand-new database if you want initial demo catalog items seeded
SEED_DEMO_DATA="false"

# ------------------------------------------------------------------------------
# Admin Portal Seed Credentials (Optional on first boot)
# ------------------------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="YOUR_INITIAL_ADMIN_PASSWORD"

# ------------------------------------------------------------------------------
# Cloudflare R2 Object Storage (MP3 Audio Lessons & PDF Books/Mutun CDN)
# Leave blank if using rclone manifest JSON import without live R2 S3 scanning.
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
R2_ENDPOINT="https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com"
R2_BUCKET="ibn-baydoah-media"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_PUBLIC_URL="https://media.yourdomain.com"

# GEMINI_API_KEY: Reserved for environment compatibility
GEMINI_API_KEY="MY_GEMINI_API_KEY"
